:root {
  --bg: #050816;
  --bg-soft: #0b1020;
  --accent: #7c5cff;
  --accent-soft: rgba(124, 92, 255, 0.15);
  --accent-strong: #ff6ec7;
  --text-main: #f9fafb;
  --text-muted: #9ca3af;
  --card-bg: #111827;
  --border-subtle: #1f2933;
  --danger: #f97373;
  --success: #4ade80;
  --radius-lg: 18px;
  --radius-md: 12px;
  --radius-pill: 999px;
  --shadow-soft: 0 18px 45px rgba(0, 0, 0, 0.45);
}

*,
*::before,
*::after {
  box-sizing: border-box;
}

body {
  margin: 0;
  font-family: "Poppins", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  background: radial-gradient(circle at top, #111827 0, #020617 55%, #000 100%);
  color: var(--text-main);
}

/* NAVBAR */

.nav {
  position: sticky;
  top: 0;
  z-index: 20;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 7vw;
  backdrop-filter: blur(18px);
  background: linear-gradient(to bottom, rgba(5, 8, 22, 0.9), rgba(5, 8, 22, 0.4));
  border-bottom: 1px solid rgba(148, 163, 184, 0.15);
}

.logo {
  font-weight: 700;
  font-size: 1.3rem;
  letter-spacing: 0.04em;
  color: var(--accent);
}

.nav nav {
  display: flex;
  gap: 20px;
}

.nav a {
  color: var(--text-muted);
  text-decoration: none;
  font-size: 0.95rem;
  transition: color 0.2s ease;
}

.nav a:hover {
  color: var(--text-main);
}

.nav-cta {
  border: none;
  border-radius: var(--radius-pill);
  padding: 8px 18px;
  background: var(--accent-soft);
  color: var(--accent);
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
}

.nav-cta:hover {
  background: rgba(124, 92, 255, 0.25);
  transform: translateY(-1px);
}

/* HERO */

main {
  padding: 32px 7vw 80px;
}

.hero {
  display: grid;
  grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
  gap: 40px;
  align-items: center;
  padding: 40px 0 60px;
}

.hero-text h1 {
  font-size: clamp(2.4rem, 4vw, 3.4rem);
  margin-bottom: 12px;
}

.hero-text p {
  color: var(--text-muted);
  max-width: 520px;
}

.hero-actions {
  display: flex;
  gap: 12px;
  margin: 24px 0 8px;
}

.primary-btn,
.secondary-btn {
  border-radius: var(--radius-pill);
  padding: 10px 22px;
  font-size: 0.95rem;
  border: none;
  cursor: pointer;
  font-weight: 500;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
}

.primary-btn {
  background: linear-gradient(135deg, var(--accent), var(--accent-strong));
  color: #fff;
  box-shadow: 0 14px 30px rgba(124, 92, 255, 0.45);
}

.primary-btn:hover {
  filter: brightness(1.05);
}

.secondary-btn {
  background: transparent;
  color: var(--text-main);
  border: 1px solid rgba(148, 163, 184, 0.4);
}

.secondary-btn:hover {
  background: rgba(15, 23, 42, 0.8);
}

.hero-subtext {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.hero-mockup {
  display: flex;
  flex-direction: column;
  gap: 16px;
}

.mockup-card {
  background: radial-gradient(circle at top left, #1f2937 0, #020617 70%);
  border-radius: var(--radius-lg);
  padding: 18px 18px 16px;
  border: 1px solid rgba(148, 163, 184, 0.25);
  box-shadow: var(--shadow-soft);
}

.mockup-card h3 {
  margin: 0 0 10px;
  font-size: 1rem;
}

.mockup-card ul {
  list-style: none;
  padding: 0;
  margin: 0;
  font-size: 0.85rem;
  color: var(--text-muted);
}

.mockup-card li + li {
  margin-top: 6px;
}

.tag {
  display: inline-block;
  font-size: 0.7rem;
  padding: 2px 8px;
  border-radius: var(--radius-pill);
  margin-right: 6px;
  color: #0b1020;
  font-weight: 600;
}

.tag.school {
  background: #bfdbfe;
}

.tag.hobby {
  background: #bbf7d0;
}

.tag.self {
  background: #fed7e2;
}

.mockup-card.secondary {
  font-size: 0.85rem;
  color: var(--text-muted);
}

.progress-bar {
  margin-top: 10px;
  width: 100%;
  height: 7px;
  border-radius: var(--radius-pill);
  background: rgba(148, 163, 184, 0.25);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--accent), var(--accent-strong));
}

/* SECTIONS */

section {
  margin-top: 40px;
}

.features h2,
.how h2,
.download h2 {
  font-size: 1.8rem;
  margin-bottom: 8px;
}

.section-subtitle {
  color: var(--text-muted);
  max-width: 520px;
}

/* FEATURES GRID */

.feature-grid {
  margin-top: 24px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.feature-card {
  background: var(--card-bg);
  border-radius: var(--radius-md);
  padding: 16px 16px 14px;
  border: 1px solid var(--border-subtle);
  box-shadow: 0 10px 25px rgba(15, 23, 42, 0.6);
}

.feature-card h3 {
  margin: 0 0 6px;
  font-size: 1rem;
}

.feature-card p {
  margin: 0;
  font-size: 0.9rem;
  color: var(--text-muted);
}

/* HOW IT WORKS */

.how .steps {
  margin-top: 24px;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 18px;
}

.step {
  background: linear-gradient(145deg, #020617, #020617, #111827);
  border-radius: var(--radius-md);
  padding: 16px;
  border: 1px solid rgba(148, 163, 184, 0.25);
}

.step-number {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 26px;
  height: 26px;
  border-radius: 999px;
  background: var(--accent-soft);
  color: var(--accent);
  font-size: 0.8rem;
  font-weight: 600;
  margin-bottom: 8px;
}

/* DOWNLOAD / CTA */

.download {
  margin-top: 60px;
  padding: 26px 20px;
  border-radius: 24px;
  background: radial-gradient(circle at top left, rgba(124, 92, 255, 0.25), transparent 55%),
              radial-gradient(circle at bottom right, rgba(248, 113, 113, 0.25), transparent 55%),
              #020617;
  border: 1px solid rgba(148, 163, 184, 0.35);
  box-shadow: 0 20px 50px rgba(15, 23, 42, 0.9);
}

.download-content p {
  color: var(--text-muted);
}

.waitlist-form {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.waitlist-form input {
  flex: 1 1 220px;
  min-width: 0;
  padding: 10px 12px;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(148, 163, 184, 0.6);
  background: rgba(15, 23, 42, 0.9);
  color: var(--text-main);
  font-family: inherit;
}

.waitlist-form input::placeholder {
  color: #6b7280;
}

.waitlist-form input:focus {
  outline: none;
  border-color: var(--accent);
}

.form-message {
  margin-top: 8px;
  font-size: 0.85rem;
}

/* FOOTER */

.footer {
  border-top: 1px solid rgba(148, 163, 184, 0.25);
  padding: 18px 7vw 26px;
  text-align: center;
  color: var(--text-muted);
  font-size: 0.85rem;
}

/* RESPONSIVE */

@media (max-width: 900px) {
  .hero {
    grid-template-columns: 1fr;
  }

  .hero-mockup {
    order: -1;
  }

  .nav {
    padding-inline: 5vw;
  }

  main {
    padding-inline: 5vw;
  }
}

@media (max-width: 640px) {
  .nav nav {
    display: none;
  }

  .hero-actions {
    flex-direction: column;
    align-items: flex-start;
  }

  .download {
    padding: 20px 16px;
  }
}

